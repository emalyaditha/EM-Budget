# EM Budget mobile — environment template
#
# Copy to `mobile/.env` (ignored by the root .gitignore, which covers `.env*` and
# un-ignores `!.env.example`) and fill in the values. Nothing reads this file at
# runtime; Dart has no process.env. These names are `--dart-define` keys:
#
#   flutter build apk --dart-define-from-file=.env
#   flutter run     --dart-define-from-file=.env
#
# The same keys must be passed to `flutter test` and `flutter run` alike, or the two
# exercise different configuration. Phase 3 adds the Dart reader for these names
# (`String.fromEnvironment`); until then this file documents the contract only. Values are baked into the binary at build time, so they are
# public by construction — which is why only the four browser-visible web variables
# appear here. Never add SUPABASE_SERVICE_ROLE_KEY, SESSION_SECRET, GEMINI_API_KEY,
# RESEND_API_KEY or any other server-only secret to this file or to the Dart sources:
# the Flutter bundle is extractable, and the mobile client authenticates with the same
# anon key + user token the web app uses, under the same row-level security.

# Supabase project URL — web equivalent: VITE_SUPABASE_URL
SUPABASE_URL=

# Supabase anon (public) key, RLS-scoped — web equivalent: VITE_SUPABASE_ANON_KEY
SUPABASE_ANON_KEY=

# Origin of the existing Express/API routes (OTP, WebAuthn, OCR free-scan).
# Web equivalent: VITE_API_URL; on web the routes are same-origin, on mobile they
# are absolute, so this must be the full scheme + host, e.g. https://app.example.com
API_URL=

# Google OAuth Web client ID, verified server-side as the ID-token audience.
# Must be the SAME client ID as VITE_GOOGLE_CLIENT_ID, with the mobile app's
# SHA-1 / bundle ID registered in Google Cloud Console.
GOOGLE_CLIENT_ID=
