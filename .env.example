# Gemini AI API key (optional — for receipt scanning)
GEMINI_API_KEY=

# SMTP config (optional — for OTP email delivery)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Server port (default: 3000)
PORT=3000
