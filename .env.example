# Gemini AI API key, used by the receipt-OCR free-scan server route.
# Optional - when unset the OCR free-scan returns a "not configured" error.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_ORIGIN: The canonical origin (scheme + host, e.g. "https://app.example.com")
# used for same-origin (CSRF) validation and WebAuthn origin checks.
# MUST be set in production deployments so the origin check cannot be bypassed
# by spoofing the Host/Origin headers. If unset, the request's own Host header is used.
APP_ORIGIN="MY_APP_ORIGIN"

# SMTP service config for OTP delivery
SMTP_FROM=
SMTP_HOST=
SMTP_PASS=
SMTP_PORT=
SMTP_USER=

# Supabase database config
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=

# Server-side service-role key (REQUIRED in production; the server refuses to
# run with the public anon key as its server role). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Cryptographic Token Secret key
# 32 random bytes as hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotate immediately if ever exposed in source control. Rotation revokes every
# issued session/device token (all users must re-login), and the server re-seeds
# public.vault.session_secret from this value on next boot.
SESSION_SECRET=

# WebAuthn Relying Party ID (e.g. the bare hostname "app.example.com" without
# scheme/port). Required for passkey (WebAuthn) registration/verification to
# succeed in production. Optional - defaults to the request host when unset.
WEB_AUTHN_RP_ID=app.example.com

# Sentry DSN (optional). When set, client+server errors are reported; when empty
# the Sentry integration is a no-op. Add via the Vercel env settings.
SENTRY_DSN=

